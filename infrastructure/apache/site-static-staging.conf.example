    </Location>
    <LocationMatch "(?i)(?:^|/)(?:\.|metadata(?:/|$)|private(?:/|$)|staging(?:/|$))|\.(?:php[0-9]*|phtml|phar|cgi|pl|py|sh|shtml|inc|conf|ini|log|sql)(?:/|$)">
        Require all denied
    </LocationMatch>
    <FilesMatch "(?i)^(?!index\.html$|_release\.json$|[0-9a-f]{64}\.(?:css|png|jpg|webp|pdf)$)">
