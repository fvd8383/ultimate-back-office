    Alias "/assets/" "@SITE_ROOT@/assets/"
    <Directory "@SITE_ROOT@">
        AllowOverride None
        Options FollowSymLinks
        SetHandler none
        RemoveHandler .php .phtml .phar .cgi .pl .py .sh .shtml
        RemoveType .php .phtml .phar .cgi .pl .py .sh .shtml
        FallbackResource disabled
        AcceptPathInfo Off
        Require all denied
    </Directory>
    <Directory "@SITE_ROOT@/releases/*/public">
