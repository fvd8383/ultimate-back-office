# TEMPLATE ONLY. Unresolved @...@ values deliberately prevent installation.
# Two private TLS bindings, distinct certificates as appropriate, no customer DNS.
# The operator must isolate these vhosts from application/global handler/rewrite config.
# Use the same reviewed policy in BOTH vhosts; configtest/reload are separate approved provisioning.
# Required modules: ssl, headers, authz_core, authz_host, mime, dir, rewrite.

<VirtualHost @PRIVATE_LISTEN_IP@:443>
    ServerName @ACTIVE_PRIVATE_HOST@
    DocumentRoot "@SITE_ROOT@/current"
    SSLEngine On
    SSLCertificateFile "@ACTIVE_CERTIFICATE@"
    SSLCertificateKeyFile "@ACTIVE_KEY@"
    SSLCACertificateFile "@PROBE_CLIENT_CA@"
    SSLVerifyClient require
    SSLVerifyDepth 2
    SSLProtocol -all +TLSv1.2 +TLSv1.3
    Protocols http/1.1
    AllowEncodedSlashes Off
    TraceEnable Off
    DirectoryIndex index.html
    ErrorDocument 503 "Temporarily unavailable"

    # No application fallback. This rule only represents the preconfigured absent state.
    RewriteEngine On
    RewriteCond "@SITE_ROOT@/current" !-l
    RewriteRule ^ - [R=503,END]

    Alias "/assets/" "@SITE_ROOT@/assets/"
    <Directory "@SITE_ROOT@">
        AllowOverride None
        Options FollowSymLinks
        SetHandler none
        RemoveHandler .php .phtml .phar .cgi .pl .py .sh .shtml
        RemoveType .php .phtml .phar .cgi .pl .py .sh .shtml
        FallbackResource disabled
        AcceptPathInfo Off
        Require all denied
    </Directory>
    <Directory "@SITE_ROOT@/releases/*/public">
        Require all granted
    </Directory>
    <Directory "@SITE_ROOT@/assets">
        Require all granted
    </Directory>
    <Location "/">
        <RequireAll>
            Require ip @APPROVED_PROBE_CIDR@
            Require expr "%{SSL_CLIENT_VERIFY} == 'SUCCESS'"
        </RequireAll>
        <LimitExcept GET HEAD>
            Require all denied
        </LimitExcept>
    </Location>
    <LocationMatch "(?i)(?:^|/)(?:\.|metadata(?:/|$)|private(?:/|$)|staging(?:/|$))|\.(?:php[0-9]*|phtml|phar|cgi|pl|py|sh|shtml|inc|conf|ini|log|sql)(?:/|$)">
        Require all denied
    </LocationMatch>
    <FilesMatch "(?i)^(?!index\.html$|_release\.json$|[0-9a-f]{64}\.(?:css|png|jpg|webp|pdf)$)">
        Require all denied
    </FilesMatch>
    AddType text/html .html
    AddType application/json .json
    AddType text/css .css
    AddType image/png .png
    AddType image/jpeg .jpg
    AddType image/webp .webp
    AddType application/pdf .pdf
    Header always set Cache-Control "no-store"
    Header always set X-Robots-Tag "noindex, nofollow, noarchive"
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "no-referrer"
    Header always set X-Frame-Options "DENY"
    Header always set Content-Security-Policy "default-src 'none'; script-src 'none'; style-src 'self'; img-src 'self'; connect-src 'none'; object-src 'none'; frame-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
    Header always unset X-Powered-By
    <IfModule mod_cache.c>
        CacheDisable /
    </IfModule>
    # Use operator-owned log destinations with bounded retention. Never log probe query/credentials.
    CustomLog "@PRIVATE_ACCESS_LOG@" "%t %m %>s %b"
    ErrorLog "@PRIVATE_ERROR_LOG@"
</VirtualHost>

# Separate private candidate binding; identical static/access policy.
<VirtualHost @PRIVATE_LISTEN_IP@:443>
    ServerName @CANDIDATE_PRIVATE_HOST@
    DocumentRoot "@SITE_ROOT@/candidate"
    SSLEngine On
    SSLCertificateFile "@CANDIDATE_CERTIFICATE@"
    SSLCertificateKeyFile "@CANDIDATE_KEY@"
    SSLCACertificateFile "@PROBE_CLIENT_CA@"
    SSLVerifyClient require
    SSLVerifyDepth 2
    SSLProtocol -all +TLSv1.2 +TLSv1.3
    Protocols http/1.1
    AllowEncodedSlashes Off
    TraceEnable Off
    DirectoryIndex index.html
