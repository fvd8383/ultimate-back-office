[Unit]
Description=UBO fresh read-only authority observation (template only)

[Service]
Type=exec
User=@AUTHORITY_USER@
Group=@AUTHORITY_GROUP@
ExecStart=/usr/bin/php -d display_errors=0 -d log_errors=0 -d zend.exception_ignore_args=1 /usr/local/lib/ubo-site-publisher/ubo-site-authority.php
StandardInput=socket
StandardOutput=socket
StandardError=journal
RuntimeMaxSec=10
TimeoutStopSec=2
KillMode=control-group
NoNewPrivileges=yes
CapabilityBoundingSet=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
UMask=0077
MemoryMax=128M
TasksMax=4
# Dedicated SELECT-only DB account, separate from worker and helper, verified TLS/native prepares.
# Network egress must be restricted to the approved DB destination by separate provisioning.
# No publication tables or files writable by this responder. No application env.php fallback.
