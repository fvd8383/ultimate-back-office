[Unit]
Description=UBO bounded site publisher session (template only)

[Service]
Type=exec
User=@PUBLISHER_USER@
Group=@PUBLISHER_GROUP@
SupplementaryGroups=@APACHE_READ_GROUP@
ExecStart=/usr/local/sbin/ubo-site-publish
StandardInput=socket
StandardOutput=socket
StandardError=journal
RuntimeMaxSec=300
TimeoutStopSec=5
KillMode=control-group
SendSIGKILL=yes
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
RestrictAddressFamilies=AF_UNIX
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryMax=256M
TasksMax=4
UMask=0077
ReadOnlyPaths=@SEALED_M6C_SOURCE_ROOT@
ReadWritePaths=@EXACT_SERVED_SITE_ROOT@ @EXACT_PRIVATE_JOURNAL_ROOT@
# Only this publisher UID writes current/releases/assets/journal. Worker has no such access.
# EOF/death releases flock with unresolved durable state; never automatic compensation.
