[Unit]
Description=UBO single bounded staging deployment invocation (template only)
Requires=ubo-site-publisher.socket ubo-site-authority.socket
After=ubo-site-publisher.socket ubo-site-authority.socket

[Service]
Type=oneshot
User=@WORKER_USER@
Group=@DEDICATED_WORKER_GROUP@
ExecStart=/usr/bin/php -d display_errors=0 -d log_errors=0 -d zend.exception_ignore_args=1 @IMMUTABLE_CHECKOUT@/scripts/site-deployment-worker.php --once
TimeoutStartSec=330
TimeoutStopSec=5
KillMode=control-group
NoNewPrivileges=yes
CapabilityBoundingSet=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
MemoryMax=256M
TasksMax=4
UMask=0077
# M6C verification opens its preexisting writer lock read/write, with no rendering.
ReadWritePaths=@VERIFIED_M6C_WORK_ROOT@
InaccessiblePaths=@EXACT_SERVED_SITE_ROOT@ @EXACT_PRIVATE_JOURNAL_ROOT@ /etc/ubo-site-publisher/authority-credentials.json
# NO write grant to served site roots, private publisher journals or Apache config.
# Network egress: only approved private HTTPS origins and DB, enforced separately.
# Reconciler needs a separately reviewed fixed invocation of --deployment ID;
# no shell, environment/path override, free-form systemd argument or operator identity flag.
